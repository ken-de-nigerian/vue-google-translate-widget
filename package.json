{
  "name": "@ken_de_nigerian/vue-google-translate-widget",
  "version": "2.1.0",
  "description": "Accessible Vue 3 and Nuxt language switcher: translate your site into 100+ languages in place, with Google's free widget or DeepL, Google Cloud, Azure and LibreTranslate.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt-types/module.d.ts",
        "default": "./dist/nuxt.js"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite playground --config vite.config.ts",
    "build": "vite build && vite build --config vite.nuxt.config.ts && node scripts/copy-cts-types.mjs",
    "preview": "vite preview playground --config vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:publish": "publint --strict && attw --pack . --profile node16 --entrypoints . ./server ./testing",
    "size": "size-limit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:publish && npm run test:package",
    "sync:languages": "node scripts/sync-languages.mjs",
    "nuxt:dev": "nuxi dev tests/fixtures/nuxt-app",
    "test:nuxt": "node scripts/nuxt-ssr-check.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:package": "node scripts/package-smoke-test.mjs",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "google-translate",
    "website-translator",
    "language-switcher",
    "language-selector",
    "multilingual",
    "localization",
    "i18n",
    "translation",
    "rtl",
    "composable",
    "typescript",
    "deepl",
    "libretranslate",
    "machine-translation",
    "accessibility",
    "a11y",
    "nuxt-module",
    "ssr"
  ],
  "author": {
    "name": "Nwaneri Chukwunyere Kenneth",
    "email": "ken.de.nigerian@gmail.com",
    "url": "https://github.com/ken-de-nigerian"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken-de-nigerian/vue-google-translate-widget.git"
  },
  "bugs": {
    "url": "https://github.com/ken-de-nigerian/vue-google-translate-widget/issues"
  },
  "homepage": "https://ken-de-nigerian.github.io/vue-google-translate-widget/",
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.60.1",
    "@nuxt/kit": "^4.6.4",
    "@nuxt/schema": "^4.6.4",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "mermaid": "^11.17.2",
    "nuxt": "^4.6.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.1.0",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.14"
  },
  "size-limit": [
    {
      "name": "GoogleTranslateWidget only",
      "path": "dist/index.js",
      "import": "{ GoogleTranslateWidget }",
      "ignore": [
        "vue"
      ],
      "limit": "12 kB"
    },
    {
      "name": "GoogleTranslateButton only",
      "path": "dist/index.js",
      "import": "{ GoogleTranslateButton }",
      "ignore": [
        "vue"
      ],
      "limit": "10 kB"
    },
    {
      "name": "useGoogleTranslate only (headless)",
      "path": "dist/index.js",
      "import": "{ useGoogleTranslate }",
      "ignore": [
        "vue"
      ],
      "limit": "8 kB"
    },
    {
      "name": "Everything",
      "path": "dist/index.js",
      "import": "*",
      "ignore": [
        "vue"
      ],
      "limit": "15 kB"
    },
    {
      "name": "Stylesheet",
      "path": "dist/style.css",
      "limit": "3 kB"
    },
    {
      "name": "Server handlers",
      "path": "dist/server.js",
      "import": "*",
      "limit": "2 kB"
    }
  ],
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  }
}
